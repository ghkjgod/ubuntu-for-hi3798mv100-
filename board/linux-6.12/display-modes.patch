+/* SiI transmitter enhanced DDC. Read each FIFO transaction in bounded chunks. */
+int mv100_sdk_edid(unsigned int block, unsigned char *buf, unsigned int len)
+{
+    unsigned int pos, i, attempt, status, count;
+    if (block > 255 || len > 128)
+        return -1;
+    for (pos = 0; pos < len; pos += count) {
+        count = len - pos > 16 ? 16 : len - pos;
+        WriteByteHDMITXP0(DDC_DELAY_CNT, 0x1a);
+        WriteByteHDMITXP0(DDC_DEV_ADDR, EDID_DEV_ADDR);
+        WriteByteHDMITXP0(0xee, block >> 1);
+        WriteByteHDMITXP0(DDC_OFFSET, (block & 1) * 128 + pos);
+        WriteByteHDMITXP0(DDC_COUNT1, count);
+        WriteByteHDMITXP0(DDC_COUNT2, 0);
+        WriteByteHDMITXP0(DDC_CMD, CLEAR_FIFO);
+        WriteByteHDMITXP0(DDC_CMD, block > 1 ? 4 : SEQ_NO_ACK);
+        for (attempt = 0; attempt < 25; ++attempt) {
+            status = ReadByteHDMITXP0(DDC_STATUS);
+            if (status & (NO_ACK | BUS_LOW))
+                return -1;
+            if (!(status & IN_PROG) && (ReadByteHDMITXP0(DDC_FIFOCNT) & 31) == count)
+                break;
+            udelay(1000);
+        }
+        if (attempt == 25)
+            return -1;
+        for (i = 0; i < count; ++i)
+            buf[pos + i] = ReadByteHDMITXP0(DDC_DATA);
+    }
+    return 0;
+}
