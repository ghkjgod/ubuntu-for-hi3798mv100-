+// SPDX-License-Identifier: GPL-2.0-only
+/* Hi3798MV100 PMC temperature sensor. Includes the per-chip temperature trim used by the vendor 4.4 driver. */
+#include <linux/delay.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/ioport.h>
+#include <linux/slab.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/thermal.h>
+
+#define TSENSOR_CTRL 0x1028
+#define TSENSOR_DATA 0x1030
+
+struct mv100_sensor {
+    struct regmap *crg;
+    int trim;
+};
+
+/* The read address and word strobe use different registers from OTP programming.
+ * Limit access to the factory temperature field. Only store its signed offset.
+ */
+static int mv100_read_temp_trim(int *trim)
+{
+    const resource_size_t base = 0xf8ab0000;
+    const size_t size = 0x24;
+    void __iomem *otp;
+    u32 status, first, second, mode;
+    int ret;
+
+    if (!request_mem_region(base, size, "mv100-temperature-trim"))
+        return -EBUSY;
+    otp = ioremap(base, size);
+    if (!otp) {
+        ret = -ENOMEM;
+        goto release;
+    }
+    ret = readl_poll_timeout(otp + 0x0c, status, status != ~0U && (status & 1), 10, 20000);
+    if (ret || (status & 2)) {
+        ret = ret ?: -EIO;
+        goto unmap;
+    }
+    writel((readl(otp) & ~3U) | 2, otp);
+    /* READ, word size, write select and write enable both clear. */
+    writel((readl(otp + 4) & ~0x37U) | 0x22, otp + 4);
+    mode = readl(otp + 0x20);
+    writel(mode | 0x34f, otp + 0x20);
+    writel(0x258, otp + 0x18);
+    ret = readl_poll_timeout(otp + 0x0c, status, status != ~0U && (status & 1), 10, 20000);
+    if (ret || (status & 2)) {
+        ret = ret ?: -EIO;
+        goto unmap;
+    }
+    first = readl(otp + 0x10);
+    writel(0x258, otp + 0x18);
+    ret = readl_poll_timeout(otp + 0x0c, status, status != ~0U && (status & 1), 10, 20000);
+    if (ret || (status & 2)) {
+        ret = ret ?: -EIO;
+        goto unmap;
+    }
+    second = readl(otp + 0x10);
+    if (first != second || first == ~0U) {
+        ret = -EIO;
+        goto unmap;
+    }
+    *trim = ((first >> 18) & 15) * ((first & BIT(22)) ? -1 : 1);
+unmap:
+    iounmap(otp);
+release:
+    release_mem_region(base, size);
+    return ret;
+}
+
+static int mv100_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+    struct mv100_sensor *sensor = thermal_zone_device_priv(tz);
+    unsigned int word, sum = 0;
+    int i, j, ret;
+
+    for (i = 0; i < 2; i++) {
+        ret = regmap_read(sensor->crg, TSENSOR_DATA + i * sizeof(word), &word);
+        if (ret)
+            return ret;
+        for (j = 0; j < 4; j++)
+            sum += (word >> (8 * j)) & 0xff;
+    }
+    if (!sum || sum == 8 * 255)
+        return -ENODATA;
+    *temp = ((int)((sum / 8) * 180 / 255) - 40 + sensor->trim) * 1000;
+    return 0;
+}
+
+static const struct thermal_zone_device_ops mv100_tz_ops = {
+    .get_temp = mv100_get_temp,
+};
+
+static int mv100_thermal_probe(struct platform_device *pdev)
+{
+    struct thermal_zone_device *tz;
+    struct mv100_sensor *sensor;
+    int ret;
+
+    sensor = devm_kzalloc(&pdev->dev, sizeof(*sensor), GFP_KERNEL);
+    if (!sensor)
+        return -ENOMEM;
+    ret = mv100_read_temp_trim(&sensor->trim);
+    if (ret)
+        return ret;
+    sensor->crg = syscon_regmap_lookup_by_phandle(pdev->dev.of_node, "hisilicon,crg");
+    if (IS_ERR(sensor->crg))
+        return PTR_ERR(sensor->crg);
+    ret = regmap_write(sensor->crg, TSENSOR_CTRL, 0x07200000);
+    if (ret)
+        return ret;
+    msleep(40);
+    tz = devm_thermal_of_zone_register(&pdev->dev, 0, sensor, &mv100_tz_ops);
+    return PTR_ERR_OR_ZERO(tz);
+}
+
+static const struct of_device_id mv100_thermal_match[] = {
+    { .compatible = "hisilicon,hi3798mv100-tsensor" },
+    {}
+};
+
+static struct platform_driver mv100_thermal_driver = {
+
+    .driver = {
+        .name = "hi3798mv100-tsensor",
+        .of_match_table = mv100_thermal_match,
+        .suppress_bind_attrs = true,
+    },
+};
+/* Called only once, after matching the EC6108 package and the PWM preset. */
+bool __init ec6108_register_thermal(void);
+bool __init ec6108_register_thermal(void)
+{
+    return !platform_driver_probe(&mv100_thermal_driver, mv100_thermal_probe);
+}
+MODULE_LICENSE("GPL");
